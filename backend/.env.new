# Mẫu cấu hình backend Flask (copy thành .env rồi điền giá trị thật)
SECRET_KEY=change-me
FLASK_DEBUG=true
# Tuỳ chọn: giới hạn Host (mặc định không lọc)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=Brazillian
POSTGRES_USER=brazillian_admin
POSTGRES_PASSWORD=123456789
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
