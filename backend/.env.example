# Example backend configuration for the unified Flask app.
# Copy to backend/.env and replace every placeholder with a real value.
# backend/.env is git-ignored and must never be committed.

# --- Flask / session auth (/api/auth/*) ---
# Mandatory outside tests; use a long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false

# --- HTTP ---
# Port 8000 is the single backend port used by the Vite dev proxy (frontend/vite.config.js).
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Legacy name still read by dss/config.py for host filtering; leave empty to allow all.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL ---
POSTGRES_DB=Brazillian
POSTGRES_USER=brazillian_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (development only; Vite proxies /api so normally not needed) ---
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
